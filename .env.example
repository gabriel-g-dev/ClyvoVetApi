# Copie este arquivo para .env e preencha os valores antes de subir o docker-compose.
# O arquivo .env nao e versionado. Nenhum destes valores existe no appsettings.json.

# Senha do container Oracle XE (docker-compose.yml).
# Oracle XE 21: use no maximo 30 caracteres para a senha.
ORACLE_PASSWORD=defina-uma-senha-forte
ORACLE_APP_USER=clyvovet
ORACLE_APP_PASSWORD=defina-outra-senha-forte

# Connection string que a API usa para falar com o banco.
# Em deploy (Azure), injete esta mesma variavel no App Service / container.
# Apontando para o Oracle do proprio compose:
ConnectionStrings__OracleConnection=User Id=clyvovet;Password=defina-outra-senha-forte;Data Source=oracle-db:1521/XEPDB1

# Para executar a API fora do container, use localhost no host Oracle e MongoDB.
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__DatabaseName=clyvovet

# Credenciais da API e chave de assinatura do JWT.
# Sem estes valores o login sempre retorna 401 e uma chave temporaria e gerada a cada inicializacao.
Auth__Username=clyvovet
Auth__Password=defina-uma-senha-forte
Auth__SigningKey=defina-uma-chave-com-pelo-menos-32-caracteres
