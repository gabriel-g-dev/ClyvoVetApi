{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "ClyvoVetApi.Logging.SafeJsonFormatter, ClyvoVetApi"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/clyvovet-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "ClyvoVetApi.Logging.SafeJsonFormatter, ClyvoVetApi"
        }
      }
    ]
  },
  "Auth": {
    "Issuer": "ClyvoVetApi",
    "Audience": "ClyvoVetApiClients",
    "ExpirationMinutes": 60
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "ConsoleExporter": false
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "clyvovet",
    "CollectionName": "evolucoes_clinicas"
  },
  "AllowedHosts": "*"
}
